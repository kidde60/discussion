# Neon PostgreSQL connection string (server-side only, never expose to the frontend)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Set to "false" to require sign-in for every page and API read.
# Anonymous visitors never see phone numbers.
PUBLIC_VIEWING=true

# Long random string used for signing/validating session data (min 32 chars)
SESSION_SECRET=replace_with_a_long_random_string
